# Copia este archivo como .env y completa los valores. El archivo .env no se sube a Git.

# Servicio
SERVER_PORT=8084

# Base de datos MySQL propia del servicio (BD-01)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=fixgo_request
DB_USERNAME=fixgo
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Puerto de MySQL expuesto en tu equipo, igual a DB_PORT (cámbialo si ya lo usa otro contenedor)
DB_HOST_PORT=3307

# Seguridad: proyecto de Firebase que emite los JWT (RNF-15)
FIREBASE_PROJECT_ID=fixgo-dev
# Opcional: otro emisor de tokens (por defecto https://securetoken.google.com/<FIREBASE_PROJECT_ID>)
# JWT_ISSUER_URI=
# Claims con el id numérico de la cuenta y el rol (provisional, Q-004)
JWT_USER_ID_CLAIM=userId
JWT_ROLE_CLAIM=role
